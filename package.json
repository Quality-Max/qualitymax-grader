{
  "name": "qualitymax-grader",
  "version": "0.2.1",
  "description": "Grade your Playwright tests A-F. Lighthouse for test quality.",
  "main": "lib/grader.js",
  "exports": {
    ".": "./lib/grader.js",
    "./reporter": "./lib/reporter.js"
  },
  "bin": {
    "qualitymax-grader": "bin/qualitymax-grader.js"
  },
  "scripts": {
    "test": "jest test/",
    "grade": "node bin/qualitymax-grader.js",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "playwright",
    "testing",
    "quality",
    "grader",
    "lint",
    "test-quality",
    "e2e",
    "automation"
  ],
  "author": "QualityMax <hello@qualitymax.io>",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Quality-Max/qualitymax-grader.git"
  },
  "homepage": "https://qualitymax.io",
  "dependencies": {
    "glob": "^13.0.6"
  },
  "engines": {
    "node": "18 || 20 || >=22"
  },
  "files": [
    "bin/",
    "lib/",
    "LICENSE",
    "README.md"
  ],
  "jest": {
    "roots": [
      "<rootDir>/test"
    ]
  },
  "devDependencies": {
    "jest": "^30.3.0"
  }
